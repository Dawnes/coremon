[Unit]
Description=Coremon master
Wants=network-online.target
After=network-online.target

[Service]
User=coremon
Group=coremon
EnvironmentFile=-/etc/coremon-master/master.env
ExecStart=/usr/local/bin/coremon-master serve -data /var/lib/coremon-master -listen :8443
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/coremon-master
# NET_BIND_SERVICE: the website on port 443. NET_RAW: pinging agentless devices
# where the system does not allow ping sockets (net.ipv4.ping_group_range).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077

[Install]
WantedBy=multi-user.target
